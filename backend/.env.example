# Keep the same URI and database used by the Node backend.
MONGO_URI=mongodb://127.0.0.1:27017/enrollment
# Leave blank to use the database in MONGO_URI (or MongoDB's test default).
MONGO_DB=
HOST=127.0.0.1
PORT=5001
RELOAD=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=false

# python configure_admin.py writes these values into .env securely.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# False preserves the former API's development behavior. Enable for deployment.
REQUIRE_ADMIN_AUTH=false

# Use one backend process. Enable transactions on an Atlas/replica-set database.
MONGO_TRANSACTIONS=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
# Optional; without these, rate limiting uses memory in this backend process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
